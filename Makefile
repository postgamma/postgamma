		--compiler "$(CC)" --objcopy "$(OBJCOPY)" --nm "$(NM)" \
		--object "$(EMBEDDED_BOOTSTRAP_PRIVATE_LIBPQ_ADAPTER_OBJECT)" \
		--object "$(EMBEDDED_BOOTSTRAP_PRIVATE_LIBPQ_TRANSPORT_OBJECT)" \
		$(foreach object,$(EMBEDDED_BOOTSTRAP_PRIVATE_LIBPQ_PATCHED_OBJECTS),--object "$(object)") \
		$(foreach archive,$(EMBEDDED_BOOTSTRAP_PRIVATE_LIBPQ_ARCHIVES),--archive "$(archive)") \
		--keep-prefix postgamma_private_libpq_ \
		--keep-prefix postgamma_memory_ \
		--namespace-archive \
			"$(EMBEDDED_PG_BUILD)/src/interfaces/libpq/libpq.a" \
		--namespace-prefix postgamma_private_libpq_symbol_ \
		--pull-symbol lo_close \
		--pull-symbol lo_create \
		--pull-symbol lo_open \
		--pull-symbol lo_read \
		--pull-symbol lo_write \
		--require-symbol postgamma_private_libpq_create \
		--require-symbol postgamma_private_libpq_connect \
		--require-symbol postgamma_private_libpq_query \
		--require-symbol postgamma_private_libpq_copy_in \
		--require-symbol postgamma_private_libpq_cancel \
		--require-symbol postgamma_private_libpq_telemetry \
		--require-symbol postgamma_private_libpq_close \
		--output "$(EMBEDDED_BOOTSTRAP_PRIVATE_LIBPQ_OBJECT)" \
		--receipt "$(EMBEDDED_BOOTSTRAP_PRIVATE_LIBPQ_LINK_REPORT)"

