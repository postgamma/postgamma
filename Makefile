		$(EMBEDDED_KERNEL_INITDB_PRIVATE_OBJECT) \
		$(EMBEDDED_KERNEL_PRODUCT_BOOTSTRAP_OBJECT) \
		$(EMBEDDED_KERNEL_STATIC_MODULE_PROVIDER_OBJECT) \
		$(EMBEDDED_KERNEL_STATIC_MODULE_OBJECT) \
		$(EMBEDDED_BOOTSTRAP_TOOL_CONTEXT_OBJECT) \
		$(EMBEDDED_BOOTSTRAP_KERNEL_RESPONSE) \
		$(EMBEDDED_KERNEL_PUBLIC_API_VERSION_SCRIPT) embedded-c-check
	@mkdir -p "$(@D)"
	@cd "$(EMBEDDED_PG_BUILD)/src/backend" && \
		$(CC) -shared -Wl,-z,defs -Wl,-Bsymbolic-functions \
			$(if $(strip $(POSTGAMMA_SHARED_SONAME)),-Xlinker -soname -Xlinker "$(POSTGAMMA_SHARED_SONAME)") \
			-Wl,--exclude-libs,ALL \
			-Wl,--version-script="$(EMBEDDED_KERNEL_PUBLIC_API_VERSION_SCRIPT)" \
			"$(abspath $(EMBEDDED_KERNEL_PUBLIC_API_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_PUBLIC_PROTOCOL_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_PUBLIC_COPY_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_PUBLIC_EVENTS_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_PUBLIC_ARROW_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_PUBLIC_MANAGEMENT_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_PUBLIC_LOGICAL_MANAGEMENT_OBJECT))" \
			"$(abspath $(EMBEDDED_LOGICAL_TOOL_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_OBJECT))" \
			"$(abspath $(EMBEDDED_BOOTSTRAP_PRIVATE_LIBPQ_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_INITDB_PRIVATE_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_PRODUCT_BOOTSTRAP_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_STATIC_MODULE_PROVIDER_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_STATIC_MODULE_OBJECT))" \
			"$(abspath $(EMBEDDED_BOOTSTRAP_TOOL_CONTEXT_OBJECT))" \
			"$(abspath $(EMBEDDED_C_LIBRARY))" \
			@"$(abspath $(EMBEDDED_BOOTSTRAP_KERNEL_RESPONSE))" \
			-pthread -o "$(abspath $@)"

