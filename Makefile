	-fmacro-prefix-map=$(BUILD_DIR)=postgamma-build \
	-ffile-prefix-map=$(EMBEDDED_BOOTSTRAP_BUILD)=postgresql-build \
	-fmacro-prefix-map=$(EMBEDDED_BOOTSTRAP_BUILD)=postgresql-build \
	-ffile-prefix-map=$(EMBEDDED_KERNEL_BUILD)=embedded-kernel-build \
	-fmacro-prefix-map=$(EMBEDDED_KERNEL_BUILD)=embedded-kernel-build \
	-ffile-prefix-map=$(EMBEDDED_LOGICAL_BUILD)=logical-management-build \
	-fmacro-prefix-map=$(EMBEDDED_LOGICAL_BUILD)=logical-management-build \
	-ffile-prefix-map=$(EMBEDDED_RELEASE_BUILD)=extension-runtime-build \
	-fmacro-prefix-map=$(EMBEDDED_RELEASE_BUILD)=extension-runtime-build \
	-ffile-prefix-map=$(ROOT)/tests/embedded/release=postgamma-source/sdk-validation \
	-fmacro-prefix-map=$(ROOT)/tests/embedded/release=postgamma-source/sdk-validation \
	-ffile-prefix-map=tests/embedded/release=postgamma-source/sdk-validation \
	-fmacro-prefix-map=tests/embedded/release=postgamma-source/sdk-validation \
