check-layout:
	@$(PYTHON) buildsys/check_layout.py --root "$(ROOT)"

version-check:
	@$(PYTHON) buildsys/product_version.py --root "$(ROOT)" \
		--output "$(PRODUCT_VERSION_EVIDENCE)"

portability-check:
	@$(PYTHON) buildsys/check_portability.py --root "$(ROOT)"

publication-check: version-check
	@$(PYTHON) buildsys/check_public_surface.py --root "$(ROOT)" \
		--make "$${MAKE:-make}" --output "$(PUBLIC_SURFACE_EVIDENCE)"

docs-api:
	@$(PYTHON) buildsys/generate_c_api_docs.py \
		--root "$(ROOT)" --doxygen "$(DOXYGEN)" \
		--doxygen-output "$(DOCS_DOXYGEN_DIR)" \
		--output-dir "$(DOCS_GENERATED_DIR)"
	@$(PYTHON) buildsys/generate_python_api_docs.py \
		--root "$(ROOT)" \
		--output "$(DOCS_GENERATED_DIR)/python-api.md"

docs-check: doctor-docs docs-api portability-check publication-check
	@$(PYTHON) -m unittest tests.buildsys.test_documentation
	@$(PYTHON) buildsys/check_documentation.py \
		--root "$(ROOT)" --output "$(DOCS_EVIDENCE)"
	@NO_MKDOCS_2_WARNING=1 \
		POSTGAMMA_DOCS_GENERATED_DIR="$(DOCS_GENERATED_DIR)" \
		$(MKDOCS) build --strict --config-file "$(ROOT)/mkdocs.yml" \
		--site-dir "$(DOCS_SITE_DIR)"

docs: docs-check

docs-serve: docs-api
	@$(PYTHON) buildsys/check_documentation.py --root "$(ROOT)"
	@NO_MKDOCS_2_WARNING=1 \
		POSTGAMMA_DOCS_GENERATED_DIR="$(DOCS_GENERATED_DIR)" \
		$(MKDOCS) serve --strict --config-file "$(ROOT)/mkdocs.yml" \
		--dev-addr "$(DOCS_DEV_ADDR)"

doctor:
	@CC="$(CC)" CXX="$(CXX)" AR="$(AR)" NM="$(NM)" \
		READELF="$(READELF)" STRACE="$(STRACE)" OBJCOPY="$(OBJCOPY)" \
		MKDOCS="$(MKDOCS)" DOXYGEN="$(DOXYGEN)" \
		$(PYTHON) buildsys/doctor.py --root "$(ROOT)" \
		--build-dir "$(BUILD_DIR)" --jobs "$(JOBS)" --require-profile all

doctor-threaded:
	@CC="$(CC)" CXX="$(CXX)" AR="$(AR)" NM="$(NM)" \
		$(PYTHON) buildsys/doctor.py --root "$(ROOT)" \
		--build-dir "$(BUILD_DIR)" --jobs "$(JOBS)" \
		--require-profile threaded

doctor-sdk:
	@CC="$(CC)" CXX="$(CXX)" AR="$(AR)" NM="$(NM)" \
		READELF="$(READELF)" STRACE="$(STRACE)" OBJCOPY="$(OBJCOPY)" \
		$(PYTHON) buildsys/doctor.py --root "$(ROOT)" \
		--build-dir "$(BUILD_DIR)" --jobs "$(JOBS)" --require-profile sdk

doctor-foundation:
	@CC="$(CC)" CXX="$(CXX)" AR="$(AR)" NM="$(NM)" \
		$(PYTHON) buildsys/doctor.py --root "$(ROOT)" \
		--build-dir "$(BUILD_DIR)" --jobs "$(JOBS)" --require-profile foundation

doctor-ast:
	@CC="$(CC)" CXX="$(CXX)" AR="$(AR)" NM="$(NM)" \
		$(PYTHON) buildsys/doctor.py --root "$(ROOT)" \
		--build-dir "$(BUILD_DIR)" --jobs "$(JOBS)" --require-profile ast

doctor-build:
	@CC="$(CC)" CXX="$(CXX)" AR="$(AR)" NM="$(NM)" \
		READELF="$(READELF)" STRACE="$(STRACE)" OBJCOPY="$(OBJCOPY)" \
		$(PYTHON) buildsys/doctor.py --root "$(ROOT)" \
		--build-dir "$(BUILD_DIR)" --jobs "$(JOBS)" --require-profile build

doctor-python:
	@CC="$(CC)" CXX="$(CXX)" AR="$(AR)" NM="$(NM)" \
		READELF="$(READELF)" STRACE="$(STRACE)" OBJCOPY="$(OBJCOPY)" \
		PG_CONFIGURE_ARGS="$(POSTGAMMA_PYTHON_PG_CONFIGURE_ARGS)" \
		PG_REFERENCE_CONFIGURE_ARGS= PG_GENERATED_CONFIGURE_ARGS= \
		PG_EMBEDDED_CONFIGURE_ARGS= \
		$(PYTHON) buildsys/doctor.py --root "$(ROOT)" \
		--build-dir "$(BUILD_DIR)" --jobs "$(JOBS)" --require-profile python

doctor-docs:
	@MKDOCS="$(MKDOCS)" DOXYGEN="$(DOXYGEN)" \
		$(PYTHON) buildsys/doctor.py --root "$(ROOT)" \
		--build-dir "$(BUILD_DIR)" --jobs "$(JOBS)" --require-profile docs

doctor-full-test:
	@CC="$(CC)" CXX="$(CXX)" AR="$(AR)" NM="$(NM)" \
		STRACE="$(STRACE)" $(PYTHON) buildsys/doctor.py --root "$(ROOT)" \
		--build-dir "$(BUILD_DIR)" --jobs "$(JOBS)" --require-profile full-test

doctor-release: doctor

bootstrap: doctor-foundation check-layout portability-check verify-upstream postgresql-adapter-check

$(EMBEDDED_C_LIBRARY): Makefile embedded-c/Makefile \
		$(sort $(wildcard embedded-c/src/*.c \
		embedded-c/include/postgamma/private/*.h \
		runtime/include/postgamma/*.h))
	@$(MAKE) -C embedded-c BUILD_DIR="$(EMBEDDED_C_BUILD)" \
		CFLAGS="$(POSTGAMMA_EMBEDDED_C_CFLAGS) $(POSTGAMMA_ARTIFACT_PATH_MAP_CFLAGS)" all

embedded-c-check: $(EMBEDDED_C_LIBRARY)
	@$(MAKE) -C embedded-c BUILD_DIR="$(EMBEDDED_C_BUILD)" \
		CFLAGS="$(POSTGAMMA_EMBEDDED_C_CFLAGS) $(POSTGAMMA_ARTIFACT_PATH_MAP_CFLAGS)" check

embedded-c-sanitizer-check:
	@$(MAKE) -C embedded-c BUILD_DIR="$(EMBEDDED_C_BUILD)" sanitizer-check

embedded-bootstrap-doctor: bootstrap embedded-pg-configure embedded-c-check
	@$(PYTHON) buildsys/check_bootstrap_evidence.py \
		--profile "$(EMBEDDED_BOOTSTRAP_PROFILE)" \
		--upstream-manifest "$(UPSTREAM_MANIFEST)" \
		--adapter "$(POSTGRES_ADAPTER)" \
		--embedded-adapter "$(POSTGRES_EMBEDDED_ADAPTER)" \
		--configure-state "$(EMBEDDED_PG_CONFIG_STATE)" \
		--config-log "$(EMBEDDED_PG_CONFIG_LOG)" \
		--build-profile embedded-bootstrap \
		--evidence-dir "$(EMBEDDED_BOOTSTRAP_REPORT_DIR)" \
		--output "$(EMBEDDED_BOOTSTRAP_REPORT)"

$(EMBEDDED_BOOTSTRAP_KERNEL_RESPONSE) $(EMBEDDED_BOOTSTRAP_KERNEL_LINK_REPORT) &: \
		$(EMBEDDED_BOOTSTRAP_LINK_DATABASE) $(EMBEDDED_PG_CONFIG_STATE) \
		$(EMBEDDED_PG_CONFIG_LOG) \
		$(UPSTREAM_MANIFEST) $(POSTGRES_ADAPTER) \
		$(POSTGRES_EMBEDDED_ADAPTER) $(EMBEDDED_BOOTSTRAP_GENERATED_SUPPORT) \
		buildsys/derive_kernel_link.py buildsys/merge_link_db.py \
		buildsys/postgresql_embedded_adapter.py
	@$(PYTHON) buildsys/derive_kernel_link.py \
		--database "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" \
		--build-root "$(EMBEDDED_PG_BUILD)" \
		--configure-state "$(EMBEDDED_PG_CONFIG_STATE)" \
		--config-log "$(EMBEDDED_PG_CONFIG_LOG)" \
		--upstream-manifest "$(UPSTREAM_MANIFEST)" \
		--embedded-adapter "$(POSTGRES_EMBEDDED_ADAPTER)" \
		--response-file "$(EMBEDDED_BOOTSTRAP_KERNEL_RESPONSE)" \
		--report "$(EMBEDDED_BOOTSTRAP_KERNEL_LINK_REPORT)"

embedded-bootstrap-link-check: $(EMBEDDED_BOOTSTRAP_KERNEL_RESPONSE) \
		$(EMBEDDED_BOOTSTRAP_KERNEL_LINK_REPORT)

$(EMBEDDED_KERNEL_OBJECT): runtime/src/postgres_embedded_kernel.c \
		runtime/include/postgamma/embedded_kernel.h \
		runtime/include/postgamma/path_runtime.h \
		runtime/include/postgamma/postmaster_control_runtime.h \
		runtime/include/postgamma/postgres_backend_runtime.h \
		$(EMBEDDED_BOOTSTRAP_GENERATED_SUPPORT) | embedded-pg-generated-headers
	@mkdir -p "$(@D)"
	@$(CC) $(EMBEDDED_BOOTSTRAP_CPPFLAGS) $(EMBEDDED_BOOTSTRAP_CFLAGS) \
		-Wno-declaration-after-statement -DPOSTGAMMA_BACKEND -pthread \
		-c "$<" -o "$@"

$(EMBEDDED_KERNEL_DRIVER_OBJECT): tests/embedded/kernel/kernel_lifecycle_driver.c \
		tests/embedded/bootstrap/host_process_probe.h \
		runtime/include/postgamma/embedded_kernel.h \
		embedded-c/include/postgamma/private/data_directory_lock.h \
		embedded-c/include/postgamma/private/kernel_supervisor_adapter.h \
		embedded-c/include/postgamma/private/supervisor.h
	@mkdir -p "$(@D)"
	@$(CC) -I$(ROOT) -I$(ROOT)/runtime/include \
		-I$(ROOT)/embedded-c/include -std=gnu11 -Wall -Wextra -Werror \
		-Wpedantic -pthread -c "$<" -o "$@"

$(EMBEDDED_KERNEL_DRIVER): $(EMBEDDED_KERNEL_DRIVER_OBJECT) \
		$(EMBEDDED_KERNEL_OBJECT) $(EMBEDDED_BOOTSTRAP_HOST_PROBE_OBJECT) \
		$(EMBEDDED_BOOTSTRAP_KERNEL_RESPONSE) embedded-c-check
	@mkdir -p "$(@D)"
	@cd "$(EMBEDDED_PG_BUILD)/src/backend" && \
		$(CC) -no-pie -rdynamic -pthread \
			"$(abspath $(EMBEDDED_KERNEL_DRIVER_OBJECT))" \
			"$(abspath $(EMBEDDED_KERNEL_OBJECT))" \
			"$(abspath $(EMBEDDED_BOOTSTRAP_HOST_PROBE_OBJECT))" \
			"$(abspath $(EMBEDDED_C_LIBRARY))" \
			@"$(abspath $(EMBEDDED_BOOTSTRAP_KERNEL_RESPONSE))" \
			-o "$(abspath $@)"

