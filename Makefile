# A virtualized backend starts with fresh process-local state and therefore
# uses PostgreSQL's own EXEC_BACKEND reattachment contracts.  This compiler
# define is part of the PostGamma execution model, while PG_CONFIGURE_ARGS and
# the per-tree configure variables remain entirely caller-owned.
POSTGAMMA_REQUIRED_PG_CPPFLAGS := -DEXEC_BACKEND
POSTGAMMA_PG_CPPFLAGS = $(strip $(CPPFLAGS) $(POSTGAMMA_REQUIRED_PG_CPPFLAGS))
POSTGAMMA_EMBEDDED_REQUIRED_CFLAGS := -fPIC
POSTGAMMA_EMBEDDED_PG_CFLAGS = $(strip $(CFLAGS) \
	$(POSTGAMMA_EMBEDDED_REQUIRED_CFLAGS))

