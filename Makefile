			--database "$(SERVER_COMPILE_DATABASE)" --source-root "$(PG_SOURCE)" \
			--generated-root "$(REFERENCE_BUILD)" \
			--candidate-manifest "$(GUC_TRANSFORM_MANIFEST)" \
			--selection-report "$(BUILD_DIR)/plans/guc-selection.json" )

