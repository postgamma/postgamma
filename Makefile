$(PGVECTOR_COMPILE_STAMP) $(PGVECTOR_COMPILE_DATABASE) &: \
		$(PGVECTOR_SOURCE_FILES) $(PGVECTOR_DOMAIN) \
		extensions/pgvector/include/postgamma_pgvector_adapter.h \
		$(EMBEDDED_BOOTSTRAP_GENERATED_SUPPORT) \
		buildsys/cc_capture.py buildsys/merge_compile_db.py \
		buildsys/reset_directory.py | embedded-pg-generated-headers
	@$(PYTHON) buildsys/reset_directory.py \
		--path "$(PGVECTOR_FRAGMENT_DIR)" --within "$(BUILD_DIR)"
	@$(PYTHON) buildsys/reset_directory.py \
		--path "$(PGVECTOR_BUILD)/inventory-objects" --within "$(BUILD_DIR)"
	@mkdir -p "$(PGVECTOR_FRAGMENT_DIR)" \
		"$(PGVECTOR_BUILD)/inventory-objects"
	@set -e; for source in $(PGVECTOR_SOURCE_FILES); do \
		name="$${source##*/}"; name="$${name%.c}"; \
		POSTGAMMA_REAL_CC="$(CC)" \
		POSTGAMMA_CAPTURE_DIR="$(PGVECTOR_FRAGMENT_DIR)" \
		$(PYTHON) buildsys/cc_capture.py \
			$(PGVECTOR_COMMON_CPPFLAGS) -I"$(PGVECTOR_SOURCE)/src" \
			-include postgamma_pgvector_adapter.h \
			-D_PG_init=postgamma_pgvector_upstream_init \
			$(PGVECTOR_CFLAGS) -c "$$source" \
			-o "$(PGVECTOR_BUILD)/inventory-objects/$$name.o"; \
	done
	@$(PYTHON) buildsys/merge_compile_db.py \
		--fragments "$(PGVECTOR_FRAGMENT_DIR)" \
		--output "$(PGVECTOR_COMPILE_DATABASE)" \
		--source-root "$(PGVECTOR_SOURCE)"
	@touch "$(PGVECTOR_COMPILE_STAMP)"

