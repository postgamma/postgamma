$(EMBEDDED_BOOTSTRAP_TRANSPORT_ASAN): embedded-c/src/memory_transport.c \
		embedded-c/include/postgamma/private/memory_transport.h \
		embedded-c/tests/test_memory_transport.c
	@mkdir -p "$(@D)"
	@$(CC) -I$(ROOT)/embedded-c/include -std=c11 -Wall -Wextra \
		-Werror -Wpedantic -pthread -fsanitize=address,undefined \
