		$(EMBEDDED_KERNEL_PUBLIC_ARROW_OBJECT) \
		$(EMBEDDED_KERNEL_PUBLIC_MANAGEMENT_OBJECT) \
		$(EMBEDDED_KERNEL_PUBLIC_LOGICAL_MANAGEMENT_OBJECT) \
		$(EMBEDDED_LOGICAL_TOOL_OBJECT) \
