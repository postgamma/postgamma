upstream-daily upstream-weekly: override PG_CONFIGURE_ARGS := $(strip \
	$(if $(POSTGAMMA_FULL_TEST_BASE_PG_CONFIGURE_ARGS),\
		$(POSTGAMMA_FULL_TEST_BASE_PG_CONFIGURE_ARGS),--without-icu) \
	$(POSTGAMMA_FULL_TEST_REQUIRED_PG_CONFIGURE_ARGS))
upstream-daily upstream-weekly:
	@$(PYTHON) buildsys/prepare_sources.py --root "$(ROOT)" \
		--postgres-source "$(PG_SOURCE)" --fetch-branch "$(PG_BRANCH)"
	@$(MAKE) upstream-canary PG_REF="origin/$(PG_BRANCH)" \
		CANARY_PROFILE="$(patsubst upstream-%,%,$@)" \
		PG_CONFIGURE_ARGS="$(PG_CONFIGURE_ARGS)"

upstream-canary:
	@$(PYTHON) buildsys/run_upstream_canary.py \
		--project-root "$(ROOT)" \
		--postgres-source "$(PG_SOURCE)" \
		--upstream-manifest "$(UPSTREAM_MANIFEST)" \
		--adapter "$(POSTGRES_ADAPTER)" \
		--guc-policy "$(GUC_OWNERSHIP)" \
		--state-policy "$(BACKEND_STATE_OWNERSHIP)" \
		--state-rules "$(BACKEND_STATE_RULES)" \
		--inheritance-policy "$(BACKEND_INHERITANCE_POLICY)" \
		--build-root "$(CANARY_BUILD_ROOT)" \
		--ref "$(PG_REF)" \
		--profile "$(CANARY_PROFILE)" \
		--stress-seconds "$(CANARY_STRESS_SECONDS)" \
		--configure-arguments "$(PG_CONFIGURE_ARGS)" \
		--make "$(MAKE)" \
		--jobs "$(JOBS)"

