POSTGAMMA_SUPPORT_PROFILE ?= validation
ifneq ($(filter check foundation-check source-transformation-check source-transformation-full-check threaded-runtime-check threaded-runtime-full-check c-api-full-check c-api-release-evidence-check,$(MAKECMDGOALS)),)
override POSTGAMMA_SUPPORT_PROFILE := validation
endif
ifeq ($(filter $(POSTGAMMA_SUPPORT_PROFILE),product validation),)
$(error POSTGAMMA_SUPPORT_PROFILE must be product or validation)
endif
POSTGAMMA_PROFILE_SUFFIX := $(if $(filter product,$(POSTGAMMA_SUPPORT_PROFILE)),-product,)

# Public entry points run a profile-specific doctor before they fan out into
# nested parallel builds.  Serialize their immediate prerequisites so even a
# caller-supplied top-level -j cannot start the graph before its doctor.  The
# nested compilation steps still use JOBS for their parallel width.
POSTGAMMA_PUBLIC_BUILD_GOALS := \
	release-candidate threaded-postgresql-build threaded-postgresql-check \
	upstream-daily upstream-weekly \
	embedded-runtime-fast-check \
	embedded-runtime-check complete-source-check python-wheel \
	python-package-check python-check static-sdk-check static-sdk-package \
	docs docs-check embedded-lifecycle-check embedded-query-check \
	embedded-crash-recovery-check embedded-soak-check \
	embedded-static-sdk-check embedded-multi-instance-check check check-head
.NOTPARALLEL: $(POSTGAMMA_PUBLIC_BUILD_GOALS) threaded-runtime-full-check

# PostgreSQL configure options are caller-owned.  The common arguments apply to
# both trees; the per-tree variables append arguments when an intentional
# reference/generated difference is required.  Values use shell-style quoting
# and are parsed into argv by buildsys/configure_postgres.py.
