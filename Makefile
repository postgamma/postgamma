capture-compile-db: reference-configure buildsys/merge_compile_db.py \
		buildsys/cc_capture.py
	@$(PYTHON) buildsys/reset_directory.py \
		--path "$(CAPTURE_DIR)/fragments" --within "$(BUILD_DIR)"
	@$(MAKE) -C "$(REFERENCE_BUILD)" clean
	@$(MAKE) -C "$(REFERENCE_BUILD)/src/backend" generated-headers
	@PATH="$(ROOT)/buildsys:$${PATH}" \
		POSTGAMMA_REAL_CC="$(CC)" \
		POSTGAMMA_REAL_CC_ARGS="$(POSTGAMMA_ARTIFACT_PATH_MAP_CFLAGS)" \
		POSTGAMMA_CAPTURE_DIR="$(CAPTURE_DIR)/fragments" \
		$(MAKE) -C "$(REFERENCE_BUILD)" -j"$(JOBS)" world-bin \
		CC="cc_capture.py"
	# PostgreSQL checkprep branches install shared test support into one prefix.
	# Serialize that install phase to avoid duplicate-target creation races.
	@PATH="$(ROOT)/buildsys:$${PATH}" \
		POSTGAMMA_REAL_CC="$(CC)" \
		POSTGAMMA_REAL_CC_ARGS="$(POSTGAMMA_ARTIFACT_PATH_MAP_CFLAGS)" \
		POSTGAMMA_CAPTURE_DIR="$(CAPTURE_DIR)/fragments" \
		$(MAKE) -C "$(REFERENCE_BUILD)" -j1 checkprep \
		CC="cc_capture.py"
	@$(PYTHON) buildsys/merge_compile_db.py \
		--fragments "$(CAPTURE_DIR)/fragments" \
		--output "$(COMPILE_DATABASE)" \
		--source-root "$(PG_SOURCE)" \
		--generated-root "$(REFERENCE_BUILD)"
	@$(MAKE) verify-upstream

# Configuration changes are represented by REFERENCE_CONFIG_STATE instead of
# deleting downstream targets as a side effect of prerequisite evaluation.
# This guard runs configuration first, then reconstructs the compiler database
# when that identity or the capture machinery is newer.  Normal Make edges
# propagate the new database through inventories, plans, and generated trees.
ensure-compile-db: reference-configure
	@if [[ ! -f "$(COMPILE_DATABASE)" || \
		"$(REFERENCE_CONFIG_STATE)" -nt "$(COMPILE_DATABASE)" || \
		"$(ROOT)/buildsys/merge_compile_db.py" -nt "$(COMPILE_DATABASE)" || \
		"$(ROOT)/buildsys/cc_capture.py" -nt "$(COMPILE_DATABASE)" || \
		"$(UPSTREAM_MANIFEST)" -nt "$(COMPILE_DATABASE)" ]]; then \
		$(MAKE) --no-print-directory capture-compile-db \
			PG_CONFIGURE_ARGS="$${PG_CONFIGURE_ARGS}" \
			PG_REFERENCE_CONFIGURE_ARGS="$${PG_REFERENCE_CONFIGURE_ARGS}"; \
	fi

capture-embedded-link-db: embedded-pg-configure $(GENERATED_TRANSFORM_PLAN) \
		buildsys/install_generated_artifacts.py buildsys/merge_link_db.py \
		buildsys/cc_capture.py
	@$(PYTHON) buildsys/reset_directory.py \
		--path "$(EMBEDDED_LINK_CAPTURE_DIR)" --within "$(BUILD_DIR)"
	@$(MAKE) -C "$(EMBEDDED_PG_BUILD)" clean
	@$(MAKE) -C "$(EMBEDDED_PG_BUILD)/src/backend" generated-headers
	@$(PYTHON) buildsys/install_generated_artifacts.py \
		--plan "$(GENERATED_TRANSFORM_PLAN)" \
		--template-root "$(REFERENCE_BUILD)" \
		--tree "$(EMBEDDED_PG_BUILD)" \
		--build-root "$(BUILD_DIR)"
	@PATH="$(ROOT)/buildsys:$${PATH}" \
		POSTGAMMA_REAL_CC="$(CC)" \
		POSTGAMMA_REAL_CC_ARGS="$(POSTGAMMA_ARTIFACT_PATH_MAP_CFLAGS)" \
		POSTGAMMA_LINK_CAPTURE_DIR="$(EMBEDDED_LINK_CAPTURE_DIR)" \
		$(MAKE) -C "$(EMBEDDED_PG_BUILD)" -j"$(JOBS)" world-bin \
		CC="cc_capture.py"
	@$(PYTHON) buildsys/merge_link_db.py \
		--fragments "$(EMBEDDED_LINK_CAPTURE_DIR)" \
		--build-root "$(EMBEDDED_PG_BUILD)" \
		--configure-state "$(EMBEDDED_PG_CONFIG_STATE)" \
		--config-log "$(EMBEDDED_PG_CONFIG_LOG)" \
		--output "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)"
	@$(MAKE) verify-upstream

ensure-embedded-link-db: embedded-pg-configure
	@if [[ ! -f "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" || \
		! -f "$(GENERATED_TRANSFORM_PLAN)" || \
		"$(EMBEDDED_PG_CONFIG_STATE)" -nt "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" || \
		"$(EMBEDDED_PG_CONFIG_LOG)" -nt "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" || \
		"$(ROOT)/buildsys/cc_capture.py" -nt "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" || \
		"$(ROOT)/buildsys/merge_link_db.py" -nt "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" || \
		"$(ROOT)/buildsys/install_generated_artifacts.py" -nt "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" || \
		"$(EMBEDDED_BOOTSTRAP_GENERATED_SUPPORT)" -nt "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" || \
		"$(POSTGRES_ADAPTER)" -nt "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" || \
		"$(GENERATED_TRANSFORM_PLAN)" -nt "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" || \
		"$(UPSTREAM_MANIFEST)" -nt "$(EMBEDDED_BOOTSTRAP_LINK_DATABASE)" ]]; then \
		$(MAKE) --no-print-directory capture-embedded-link-db \
			PG_CONFIGURE_ARGS="$${PG_CONFIGURE_ARGS}" \
			PG_EMBEDDED_CONFIGURE_ARGS="$${PG_EMBEDDED_CONFIGURE_ARGS}"; \
	fi

