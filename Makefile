	@$(PYTHON) buildsys/install_generated_support.py \
		--project-root "$(ROOT)" \
		--runtime-dir "$(GUC_RUNTIME_DIR)" \
		--tree "$(EMBEDDED_BOOTSTRAP_GENERATED_SOURCE)" \
		--adapter "$(POSTGRES_ADAPTER)" \
		--profile product $(VERIFY_UPSTREAM_PROBE_ARG)
	@$(MAKE) verify-upstream

