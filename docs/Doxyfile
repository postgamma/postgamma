PROJECT_NAME           = "PostGamma C SDK"
PROJECT_BRIEF          = "Stable in-process PostgreSQL C APIs"
OUTPUT_DIRECTORY       = build/docs/doxygen
INPUT                  = embedded-c/include/postgamma/postgamma.h \
                         embedded-c/include/postgamma/postgamma_arrow.h \
                         embedded-c/include/postgamma/postgamma_extension.h
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = PGM_API=
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
