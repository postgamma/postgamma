{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "skipLibCheck": true,
    "declaration": true, "emitDeclarationOnly": true,
    "rootDir": "src", "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
