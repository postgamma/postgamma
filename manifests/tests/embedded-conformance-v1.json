    },
    {
      "name": "secondary_application_name",
      "category": "session",
      "session": "secondary",
      "sql": "SELECT current_setting('application_name') AS value",
      "expected_kind": "tuples"
    },
    {
      "name": "create_temporary_table",
      "category": "temporary",
      "session": "primary",
