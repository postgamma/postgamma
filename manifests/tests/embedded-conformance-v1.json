    },
    {
      "name": "savepoint_rollback",
      "category": "savepoint",
      "session": "primary",
      "sql": "ROLLBACK TO SAVEPOINT pgm_before_update",
      "expected_kind": "command"
    },
    {
      "name": "savepoint_value",
      "category": "savepoint",
      "session": "primary",
      "sql": "SELECT label FROM pgm_conformance WHERE id = 4",
      "expected_kind": "tuples"
    },
    {
      "name": "savepoint_release",
      "category": "savepoint",
      "session": "primary",
      "sql": "RELEASE SAVEPOINT pgm_before_update",
      "expected_kind": "command"
    },
    {
      "name": "savepoint_commit",
      "category": "transaction",
      "session": "primary",
      "sql": "COMMIT",
      "expected_kind": "command"
    },
    {
      "name": "error_begin",
      "category": "transaction",
      "session": "primary",
      "sql": "BEGIN",
      "expected_kind": "command"
    },
    {
      "name": "division_by_zero",
      "category": "error",
      "session": "primary",
      "sql": "SELECT 1 / 0",
