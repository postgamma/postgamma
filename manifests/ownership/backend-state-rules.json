{
  "schema_version": 1,
  "kind": "postgamma.backend-state-review-rules",
  "default_decision": {
    "owner": "role",
    "rationale": "role-local process-boundary emulation; no reviewed instance-sharing contract exists"
  },
  "rules": [
    {
      "id": "external:ActiveInjectionPoints",
      "availability": "conditional",
      "condition": "USE_INJECTION_POINTS"
    },
    {
      "id": "external:Debug_copy_parse_plan_trees",
      "availability": "conditional",
      "condition": "DEBUG_NODE_TESTS_ENABLED"
    },
    {
      "id": "external:Debug_raw_expression_coverage_test",
      "availability": "conditional",
      "condition": "DEBUG_NODE_TESTS_ENABLED"
    },
    {
      "id": "external:Debug_write_read_parse_plan_trees",
      "availability": "conditional",
      "condition": "DEBUG_NODE_TESTS_ENABLED"
    },
    {
      "id": "external:restore_location_fields",
      "availability": "conditional",
      "condition": "DEBUG_NODE_TESTS_ENABLED"
    },
    {
      "id": "external:pg_dir_create_mode",
      "owner": "instance",
      "rationale": "derived once from PGDATA permissions during instance startup and shared unchanged by every backend role"
    },
    {
      "id": "external:pg_file_create_mode",
      "owner": "instance",
      "rationale": "derived once from PGDATA permissions during instance startup and shared unchanged by every backend role"
    },
    {
      "id": "external:pg_mode_mask",
      "owner": "instance",
      "rationale": "derived once from PGDATA permissions during instance startup and shared unchanged by every backend role"
    },
    {
      "id": "external:session_timezone",
      "owner": "session",
      "rationale": "current SQL session timezone; it must migrate with the session rather than remain attached to a role worker"
    },
    {
      "id": "function_static:@generated/src/backend/bootstrap/bootparse.c:@generated/src/backend/bootstrap/bootparse.c:boot_yyparse:yyval_default",
      "owner": "immutable",
      "rationale": "read-only zero-value template emitted by Bison"
    },
    {
      "id": "function_static:@generated/src/backend/parser/gram.c:@generated/src/backend/parser/gram.c:base_yyparse:yyloc_default",
      "owner": "immutable",
      "rationale": "read-only zero-location template emitted by Bison"
    },
    {
      "id": "function_static:@generated/src/backend/parser/gram.c:@generated/src/backend/parser/gram.c:base_yyparse:yyval_default",
      "owner": "immutable",
      "rationale": "read-only zero-value template emitted by Bison"
    },
    {
      "id": "function_static:@generated/src/backend/replication/repl_gram.c:@generated/src/backend/replication/repl_gram.c:replication_yyparse:yyval_default",
      "owner": "immutable",
      "rationale": "read-only zero-value template emitted by Bison"
    },
    {
      "id": "function_static:@generated/src/backend/replication/syncrep_gram.c:@generated/src/backend/replication/syncrep_gram.c:syncrep_yyparse:yyval_default",
      "owner": "immutable",
      "rationale": "read-only zero-value template emitted by Bison"
    },
    {
      "id": "function_static:@generated/src/backend/utils/adt/jsonpath_gram.c:@generated/src/backend/utils/adt/jsonpath_gram.c:jsonpath_yyparse:yyval_default",
      "owner": "immutable",
      "rationale": "read-only zero-value template emitted by Bison"
    },
    {
      "id": "function_static:src/backend/backup/basebackup.c:src/backend/backup/basebackup.c:verify_page_checksum:hit",
      "availability": "conditional",
      "condition": "USE_INJECTION_POINTS"
    },
    {
      "id": "function_static:src/backend/replication/logical/origin.c:src/backend/replication/logical/origin.c:StartupReplicationOrigin:already_started",
      "availability": "conditional",
      "condition": "USE_ASSERT_CHECKING"
    },
    {
      "id": "function_static:src/backend/utils/adt/jsonpath_exec.c:src/backend/utils/adt/jsonpath_exec.c:executeDateTimeMethod:fmt_str",
      "owner": "immutable",
      "rationale": "read-only format table used to size another function-static array"
    },
    {
      "id": "function_static:src/backend/utils/cache/inval.c:src/backend/utils/cache/inval.c:AcceptInvalidationMessages:recursion_depth",
      "availability": "conditional",
      "condition": "USE_ASSERT_CHECKING"
    },
    {
      "id": "internal:@generated/src/backend/parser/scan.c:@generated/src/backend/parser/scan.c::yy_start_state_list",
      "owner": "immutable",
      "rationale": "read-only start-state lookup table emitted by Flex"
    },
    {
      "id": "internal:@generated/src/backend/utils/adt/jsonpath_scan.c:@generated/src/backend/utils/adt/jsonpath_scan.c::yy_start_state_list",
      "owner": "immutable",
      "rationale": "read-only start-state lookup table emitted by Flex"
    },
    {
      "id": "internal:src/backend/lib/rbtree.c:src/backend/lib/rbtree.c::sentinel",
      "owner": "immutable",
      "rationale": "read-only red-black-tree NIL sentinel; all uses take its address and no code mutates it"
    },
    {
      "id": "internal:src/backend/postmaster/checkpointer.c:src/backend/postmaster/checkpointer.c::CheckpointerShmem",
      "owner": "instance",
      "rationale": "shared-memory checkpoint state is common to every role in one PostgreSQL instance"
    },
    {
      "id": "internal:src/backend/storage/file/fd.c:src/backend/storage/file/fd.c::temporary_files_allowed",
      "availability": "conditional",
      "condition": "USE_ASSERT_CHECKING"
    },
    {
      "id": "internal:src/backend/storage/lmgr/lock.c:src/backend/storage/lmgr/lock.c::Dummy_trace",
      "owner": "immutable",
      "rationale": "non-LOCK_DEBUG sentinel referenced only by const lock-method tables"
    },
    {
      "id": "internal:src/backend/utils/misc/injection_point.c:src/backend/utils/misc/injection_point.c::InjectionPointCache",
      "availability": "conditional",
      "condition": "USE_INJECTION_POINTS"
    },
    {
      "id": "internal:src/backend/utils/activity/pgstat.c:src/backend/utils/activity/pgstat.c::pgstat_is_initialized",
      "availability": "conditional",
      "condition": "USE_ASSERT_CHECKING"
    },
    {
      "id": "internal:src/backend/utils/activity/pgstat.c:src/backend/utils/activity/pgstat.c::pgstat_is_shutdown",
      "availability": "conditional",
      "condition": "USE_ASSERT_CHECKING"
    },
    {
      "id": "internal:src/backend/utils/adt/pg_locale_icu.c:src/backend/utils/adt/pg_locale_icu.c::icu_converter",
      "owner": "session",
      "rationale": "ICU converter is documented by PostgreSQL as one per session and depends on the database encoding",
      "availability": "conditional",
      "condition": "USE_ICU"
    },
    {
      "id": "internal:src/test/modules/injection_points/injection_points.c:src/test/modules/injection_points/injection_points.c::inj_list_local",
      "availability": "conditional",
      "condition": "USE_INJECTION_POINTS"
    },
    {
      "id": "internal:src/test/modules/injection_points/injection_points.c:src/test/modules/injection_points/injection_points.c::inj_state",
      "availability": "conditional",
      "condition": "USE_INJECTION_POINTS"
    },
    {
      "id": "internal:src/test/modules/injection_points/injection_points.c:src/test/modules/injection_points/injection_points.c::injection_point_local",
      "availability": "conditional",
      "condition": "USE_INJECTION_POINTS"
    }
  ]
}
