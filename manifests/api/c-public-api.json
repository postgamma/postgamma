  "state_models": [
    {
      "name": "instance-lifecycle",
      "initial": "absent",
      "states": ["absent", "open", "failed", "closed"],
      "terminal": ["closed"],
      "transitions": [
        {"operation": "pgm_instance_open", "from": "absent", "to": "open", "outcome": "ok"},
        {"operation": "pgm_instance_close", "from": "open", "to": "open", "outcome": "retryable-failure"},
        {"operation": "internal:instance-failure", "from": "open", "to": "failed", "outcome": "fatal"},
        {"operation": "pgm_instance_close", "from": "open", "to": "closed", "outcome": "ok"},
        {"operation": "pgm_instance_close", "from": "failed", "to": "closed", "outcome": "ok"}
      ]
    },
    {
      "name": "connection-lifecycle",
      "initial": "absent",
      "states": ["absent", "idle", "request-active", "failed", "closed"],
      "terminal": ["closed"],
      "transitions": [
        {"operation": "pgm_connection_open", "from": "absent", "to": "idle", "outcome": "ok"},
        {"operation": "pgm_execute_async_ex", "from": "idle", "to": "request-active", "outcome": "ok"},
        {"operation": "pgm_request_free", "from": "request-active", "to": "idle", "outcome": "retired"},
        {"operation": "internal:retirement-failure", "from": "request-active", "to": "failed", "outcome": "bounded-abort"},
        {"operation": "pgm_connection_close", "from": "idle", "to": "closed", "outcome": "ok"},
        {"operation": "pgm_connection_close", "from": "failed", "to": "closed", "outcome": "ok"}
      ]
    },
    {
      "name": "statement-lifecycle",
      "initial": "absent",
      "states": ["absent", "prepared", "request-active", "closed"],
      "terminal": ["closed"],
      "transitions": [
        {"operation": "pgm_statement_prepare", "from": "absent", "to": "prepared", "outcome": "ok"},
        {"operation": "pgm_statement_execute_async", "from": "prepared", "to": "request-active", "outcome": "ok"},
        {"operation": "pgm_request_free", "from": "request-active", "to": "prepared", "outcome": "retired"},
        {"operation": "pgm_statement_close", "from": "prepared", "to": "closed", "outcome": "ok"}
      ]
    },
    {
      "name": "request-protocol",
      "initial": "absent",
      "states": ["absent", "pending", "running", "result-ready", "copy-active", "completed", "canceled", "failed", "freed"],
      "terminal": ["freed"],
      "transitions": [
        {"operation": "pgm_execute_async_ex", "from": "absent", "to": "pending", "outcome": "ok"},
        {"operation": "pgm_request_progress", "from": "pending", "to": "running", "outcome": "progress"},
        {"operation": "pgm_request_next_result", "from": "running", "to": "result-ready", "outcome": "result"},
        {"operation": "pgm_result_free", "from": "result-ready", "to": "running", "outcome": "more-results"},
        {"operation": "pgm_result_take_copy", "from": "result-ready", "to": "copy-active", "outcome": "copy-start"},
        {"operation": "pgm_copy_close", "from": "copy-active", "to": "running", "outcome": "copy-ended"},
        {"operation": "pgm_request_progress", "from": "running", "to": "completed", "outcome": "end"},
        {"operation": "pgm_request_cancel", "from": "pending", "to": "canceled", "outcome": "canceled"},
        {"operation": "pgm_request_cancel", "from": "running", "to": "canceled", "outcome": "canceled"},
        {"operation": "internal:request-failure", "from": "running", "to": "failed", "outcome": "failed"},
        {"operation": "pgm_request_free", "from": "completed", "to": "freed", "outcome": "released"},
        {"operation": "pgm_request_free", "from": "canceled", "to": "freed", "outcome": "released"},
        {"operation": "pgm_request_free", "from": "failed", "to": "freed", "outcome": "released"}
      ]
    },
    {
      "name": "copy-lifecycle",
      "initial": "absent",
      "states": ["absent", "active", "finishing", "aborted", "closed"],
      "terminal": ["closed"],
      "transitions": [
        {"operation": "pgm_result_take_copy", "from": "absent", "to": "active", "outcome": "ok"},
        {"operation": "pgm_copy_finish", "from": "active", "to": "finishing", "outcome": "progress"},
        {"operation": "pgm_copy_abort", "from": "active", "to": "aborted", "outcome": "aborted"},
        {"operation": "pgm_copy_close", "from": "active", "to": "closed", "outcome": "retired"},
        {"operation": "pgm_copy_close", "from": "finishing", "to": "closed", "outcome": "retired"},
        {"operation": "pgm_copy_close", "from": "aborted", "to": "closed", "outcome": "retired"}
      ]
    },
    {
      "name": "event-lifecycle",
      "initial": "queued",
      "states": ["queued", "owned", "dispatched", "dropped", "freed"],
      "terminal": ["dispatched", "dropped", "freed"],
      "transitions": [
        {"operation": "pgm_instance_next_event", "from": "queued", "to": "owned", "outcome": "transferred"},
        {"operation": "pgm_event_free", "from": "owned", "to": "freed", "outcome": "released"},
        {"operation": "pgm_instance_dispatch", "from": "queued", "to": "dispatched", "outcome": "callback"},
        {"operation": "internal:event-overflow", "from": "queued", "to": "dropped", "outcome": "observable-overflow"}
      ]
    },
    {
      "name": "operation-lifecycle",
      "initial": "absent",
      "states": ["absent", "pending", "running", "completed", "canceled", "failed", "freed"],
      "terminal": ["freed"],
      "transitions": [
        {"operation": "pgm_instance_checkpoint_async", "from": "absent", "to": "pending", "outcome": "ok"},
        {"operation": "pgm_instance_logical_dump_async", "from": "absent", "to": "pending", "outcome": "ok"},
        {"operation": "pgm_instance_logical_restore_async", "from": "absent", "to": "pending", "outcome": "ok"},
        {"operation": "pgm_instance_maintenance_async", "from": "absent", "to": "pending", "outcome": "ok"},
        {"operation": "pgm_operation_progress", "from": "pending", "to": "running", "outcome": "progress"},
        {"operation": "pgm_operation_progress", "from": "running", "to": "completed", "outcome": "ok"},
        {"operation": "pgm_operation_cancel", "from": "pending", "to": "canceled", "outcome": "canceled"},
        {"operation": "internal:operation-failure", "from": "running", "to": "failed", "outcome": "failed"},
        {"operation": "pgm_operation_free", "from": "completed", "to": "freed", "outcome": "released"},
        {"operation": "pgm_operation_free", "from": "canceled", "to": "freed", "outcome": "released"},
        {"operation": "pgm_operation_free", "from": "failed", "to": "freed", "outcome": "released"}
      ]
    }
  ],
  "pre_v1_changes": [
    {
      "id": "explicit-result-kind-set",
      "removed": {"PGM_RESULT_OTHER": 4},
      "replacement": {"PGM_RESULT_EMPTY_QUERY": 4, "PGM_RESULT_TUPLES_CHUNK": 5, "PGM_RESULT_ERROR": 6},
      "reason": "Replace a catch-all pre-release value with protocol-exact result kinds before ABI v1 freezes."
    }
  ],
