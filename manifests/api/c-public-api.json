  "profiles": {
    "metadata": {
      "ownership": "returns a borrowed static value or an integer value",
      "blocking": "never blocks",
      "thread_safety": "safe from any host thread",
      "callback_context": "does not dispatch callbacks",
      "errors": "has no error output",
      "allowed_states": [
        "library-loaded"
      ]
    },
    "open": {
      "ownership": "returns one caller-owned handle on success and no handle on failure",
      "blocking": "may block within the documented startup deadline",
      "thread_safety": "the output handle is unpublished until success",
      "callback_context": "does not dispatch user callbacks before publication",
      "errors": "clears error first and returns one owned diagnostic when allocation permits",
      "allowed_states": [
        "parent-open",
        "no-existing-handle"
      ]
    },
    "close": {
      "ownership": "consumes the handle only on PGM_STATUS_OK and permits retry otherwise",
      "blocking": "may block only within the supplied deadline",
      "thread_safety": "requires external serialization except for documented cancel or inspection",
      "callback_context": "callbacks caused by progress run on the calling host thread",
      "errors": "returns BUSY while public children exist and an owned diagnostic on failure",
      "allowed_states": [
        "open",
        "failed-but-closable"
      ]
    },
    "inspect": {
      "ownership": "returns a borrowed view or copies a value into caller storage",
      "blocking": "never performs SQL progress and takes only bounded internal locks",
      "thread_safety": "read-only inspection is allowed from the documented secondary thread",
      "callback_context": "does not dispatch callbacks",
      "errors": "invalid handles or output storage return a deterministic status",
      "allowed_states": [
        "open",
        "active",
        "terminal-not-freed"
      ]
    },
    "submit": {
      "ownership": "copies submission inputs and returns one caller-owned request on success",
      "blocking": "does bounded submission work but does not wait for SQL completion",
      "thread_safety": "one submitting thread per connection with one active request",
      "callback_context": "does not invoke a user callback before returning",
      "errors": "rejects invalid options before submission and returns an owned diagnostic",
      "allowed_states": [
        "connection-idle"
      ]
    },
    "progress": {
      "ownership": "does not transfer ownership unless an explicit output says so",
      "blocking": "poll and progress are nonblocking; wait honors its deadline",
      "thread_safety": "one progress or wait thread per request",
      "callback_context": "dispatches callbacks only on the calling host thread",
      "errors": "normal AGAIN or END is reported through availability state, not pgm_status",
      "allowed_states": [
        "pending",
        "running",
        "result-ready",
        "copy-active",
        "terminal-not-freed"
      ]
    },
    "accessor": {
      "ownership": "returns a borrowed view whose lifetime is bounded by its owner handle",
      "blocking": "never blocks",
      "thread_safety": "requires the owner not to be concurrently mutated or freed",
      "callback_context": "does not dispatch callbacks",
      "errors": "status-returning accessors reject invalid indexes and storage",
      "allowed_states": [
        "owned"
      ]
    },
    "free": {
      "ownership": "consumes the owned handle and accepts NULL or an invalidated no-op only where documented",
      "blocking": "ordinary values do not block; request retirement is bounded",
      "thread_safety": "must not race an operation on the same handle",
      "callback_context": "request retirement may dispatch only on the calling host thread",
      "errors": "void destructors cannot report failure and follow their fail-closed contract",
      "allowed_states": [
        "owned",
        "terminal-not-freed"
      ]
    },
    "copy_io": {
      "ownership": "retains the COPY handle and reports partial byte ownership through consumed or produced",
      "blocking": "never waits for unbounded queue capacity and reports AGAIN through pgm_io_state",
      "thread_safety": "one I/O owner thread; one other thread may cancel or inspect",
      "callback_context": "duplex progress dispatches callbacks only on the calling host thread",
      "errors": "a failure leaves the connection reusable or explicitly failed after bounded retirement",
      "allowed_states": [
        "copy-active",
        "copy-finishing"
      ]
    },
    "event": {
      "ownership": "returns or inspects one caller-owned routed event",
      "blocking": "next-event honors its deadline; accessors never block",
      "thread_safety": "one event consumer model per instance",
      "callback_context": "dispatch invokes callbacks only on the calling host thread",
      "errors": "queue overflow is an observable event and monotonic telemetry, never silent loss",
      "allowed_states": [
        "instance-open",
        "event-owned"
      ]
    },
    "management": {
      "ownership": "returns or progresses one instance-owned operation handle",
      "blocking": "progress is caller-driven and waitable access never runs a subprocess",
      "thread_safety": "one progress owner and one documented cancellation thread",
      "callback_context": "callbacks run only on the progressing host thread",
      "errors": "unsupported operations fail closed without subprocesses or network endpoints",
      "allowed_states": [
        "instance-open",
        "operation-active",
        "operation-terminal"
      ]
    },
    "management_stream": {
      "ownership": "copies operation options and returns one caller-owned operation handle",
      "blocking": "submission is bounded; progress transfers at most one quantum and reports backpressure",
      "thread_safety": "one progress owner and one documented cancellation thread per operation",
      "callback_context": "stream callbacks run only on the host thread calling progress",
      "errors": "callback, archive, and PostgreSQL failures become owned operation diagnostics",
      "allowed_states": [
        "instance-open",
        "operation-active",
        "operation-terminal"
      ]
    }
  },
