    {"name": "pgm_result_export_arrow", "phase": "arrow-management", "profile": "accessor", "owner": "arrow_adapter", "test": "arrow", "object": "pgm_result", "ownership": "exports caller-owned Arrow objects without consuming the source result"},
    {"name": "pgm_result_free", "phase": "session-execution", "profile": "free", "owner": "public_core", "test": "public_api", "object": "pgm_result"},

