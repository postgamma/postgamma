{
  "schema_version": 1,
  "kind": "postgamma.wasm-probe-profile",
  "status": "candidate",
  "target": "wasm32-emscripten-pthreads",
  "emsdk": {
    "version": "6.0.9",
    "repository": "https://github.com/emscripten-core/emsdk.git",
    "commit": "5eb0bde7585670252e8ba05e9d361627bffd08b5"
  },
  "browser_host_packages": {
    "ubuntu-24.04-x86_64": [
      "libasound2t64", "libatk-bridge2.0-0t64", "libatk1.0-0t64",
      "libatspi2.0-0t64", "libcairo2", "libcups2t64", "libdbus-1-3",
      "libdrm2", "libgbm1", "libglib2.0-0t64", "libnspr4", "libnss3",
      "libpango-1.0-0", "libx11-6", "libxcb1", "libxcomposite1",
      "libxdamage1", "libxext6", "libxfixes3", "libxkbcommon0", "libxrandr2"
    ]
  },
  "compile_flags": ["-std=c11", "-Wall", "-Wextra", "-Werror", "-pthread"],
  "link_flags": [
    "--no-entry",
    "-pthread",
    "-sMODULARIZE=1",
    "-sEXPORT_ES6=1",
    "-sEXPORTED_RUNTIME_METHODS=[\"HEAPU8\"]",
    "-sENVIRONMENT=worker",
    "-sPTHREAD_POOL_SIZE=1",
    "-sPTHREAD_POOL_SIZE_STRICT=2",
    "-sALLOW_BLOCKING_ON_MAIN_THREAD=0",
    "-sINITIAL_MEMORY=33554432",
    "-sMAXIMUM_MEMORY=134217728",
    "-sALLOW_MEMORY_GROWTH=1",
    "-sSTACK_SIZE=1048576",
    "-sDEFAULT_PTHREAD_STACK_SIZE=1048576",
    "-sFILESYSTEM=0"
  ],
  "modes": {
    "debug": {
      "compile_flags": ["-O0", "-g3"],
      "link_flags": ["-O0", "-g3", "-sASSERTIONS=2"]
    },
    "release": {
      "compile_flags": ["-O2"],
      "link_flags": ["-O2", "-sASSERTIONS=1"]
    }
  },
  "probes": {
    "opfs": {
      "link_flags": [
        "-sWASMFS=1",
        "-sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=[\"$stringToUTF8OnStack\"]",
        "-sFILESYSTEM=1",
        "-sPTHREAD_POOL_SIZE=4",
        "-sSTACK_OVERFLOW_CHECK=2",
        "-sEXPORTED_RUNTIME_METHODS=[\"HEAPU8\",\"UTF8ToString\"]"
      ]
    },
    "recovery": {
      "link_flags": [
        "-sPTHREAD_POOL_SIZE=3",
        "-sSTACK_OVERFLOW_CHECK=2",
        "-sEXPORTED_RUNTIME_METHODS=[\"HEAPU8\",\"UTF8ToString\"]"
      ]
    },
    "wait": {
      "link_flags": [
        "-sPTHREAD_POOL_SIZE=3",
        "-sSTACK_OVERFLOW_CHECK=2",
        "-sEXPORTED_RUNTIME_METHODS=[\"HEAPU8\",\"UTF8ToString\"]"
      ]
    },
    "platform": {
      "link_flags": [
        "-sPTHREAD_POOL_SIZE=3",
        "-sFILESYSTEM=1",
        "-sSTACK_OVERFLOW_CHECK=2",
        "-sEXPORTED_RUNTIME_METHODS=[\"HEAPU8\",\"UTF8ToString\"]"
      ],
      "module_link_flags": {
        "stack-overflow": [
          "-sSTACK_SIZE=65536",
          "-sDEFAULT_PTHREAD_STACK_SIZE=65536",
          "-sPTHREAD_POOL_SIZE=1",
          "-sFILESYSTEM=0"
        ]
      }
    }
  }
}
